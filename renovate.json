{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": false,
  "dependencyDashboard": true,
  "schedule": ["* 3 * * 1"],

  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],

  "timezone": "America/Bahia",

  "docker-compose": {
    "enabled": true
  },

  "customManagers": [
    {
      "customType": "regex",
      "description": "Versao do Bulma carregada pelo CDN jsDelivr",
      "managerFilePatterns": [
        "/(^|/)index\\.html$/"
      ],
      "matchStrings": [
        "cdn\\.jsdelivr\\.net/npm/(?<depName>[^@/\"']+)@(?<currentValue>[^/\"']+)/"
      ],
      "datasourceTemplate": "npm"
    }
  ],

  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions"
    },

    {
      "matchUpdateTypes": [
        "major"
      ],

      "labels": [
        "major-update",
        "manual-review"
      ]
    }
  ]
}