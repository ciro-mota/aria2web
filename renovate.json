{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "config:recommended"
  ],
  
  "automerge": false,
  
  "dependencyDashboard": true,

  "timezone": "America/Bahia",

  "ignoreTests": true,

  "pinDigests": true,

  "docker-compose": {
    "enabled": true
  },

  "customManagers": [
    {
      "customType": "regex",
      "description": "Versao do Bulma carregada pelo CDN jsDelivr",
      "managerFilePatterns": [
        "/(^|/)index\\.html$/"
      ],
      "matchStrings": [
        "cdn\\.jsdelivr\\.net/npm/(?<depName>[^@/\"']+)@(?<currentValue>[^/\"']+)/"
      ],
      "datasourceTemplate": "npm"
    }
  ],

  "packageRules": [
    
    {
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["pin", "digest", "patch", "minor"],
      "addLabels": ["automerge"]
    },
    {
      "matchUpdateTypes": ["major"],
      "addLabels": ["major-update", "manual-review"]
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],

      "labels": [
        "major-update",
        "manual-review"
      ]
    }
  ]
}
