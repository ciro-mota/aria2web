{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "config:recommended"
  ],

  "dependencyDashboard": true,

  "timezone": "America/Bahia",

  "ignoreTests": true,

  "pinDigests": true,

  "docker-compose": {
    "enabled": true
  },

  "customManagers": [
    {
      "customType": "regex",
      "description": "Versao do Bulma carregada pelo CDN jsDelivr",
      "managerFilePatterns": [
        "/(^|/)index\\.html$/"
      ],
      "matchStrings": [
        "cdn\\.jsdelivr\\.net/npm/(?<depName>[^@/\"']+)@(?<currentValue>[^/\"']+)/"
      ],
      "datasourceTemplate": "npm"
    }
  ],

  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "addLabels": ["docker", "automerge"]
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["automerge"]
    },
    {
      "matchUpdateTypes": ["pin", "digest", "patch", "minor"],
      "addLabels": ["automerge"]
    },
    {
      "matchUpdateTypes": ["major"],
      "addLabels": ["major-update", "manual-review"]
    }
  ]
}